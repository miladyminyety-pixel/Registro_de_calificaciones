# Copia este archivo a .env para desarrollo local (el archivo .env NO se sube a GitHub).

# Clave para firmar sesiones. En producción (Render) se genera sola.
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio

# Usuario inicial (solo se crea si todavía no existe ningún usuario)
ADMIN_USERNAME=docente
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME=Lic. Nombre Apellido

# Cargar estudiantes y notas de ejemplo si la base está vacía (true/false)
SEED_DEMO_DATA=true

# Base de datos. Vacío = SQLite local en instance/registro.db.
# En Render se completa sola con PostgreSQL.
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/registro
